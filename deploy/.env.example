# Copy to .env and fill in. Never commit .env: it holds secrets.

# The site's domain (its DNS must point to this server). Use "localhost" to try it on your own machine.
DOMAIN=wordrise.example.com
# Where Let's Encrypt sends certificate warnings.
ACME_EMAIL=you@example.com

# A long random password, letters and digits only (it goes inside a connection string).
# The database and the API share it.
POSTGRES_PASSWORD=

# The account that becomes the admin (register it on the site first, then restart the api).
ADMIN_EMAIL=you@example.com

# Lesson writing: key from console.anthropic.com. Leave empty until you have one.
AUTHORING_PROVIDER=Claude
CLAUDE_API_KEY=

# Audio: None keeps the device voice; Azure needs the two values below from an Azure Speech resource.
MEDIA_PROVIDER=None
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
