# Copy to .env and fill in. Never commit .env: it holds secrets.
# A line left empty means "not set": the app then uses the value in appsettings.json.

# The site's domain (its DNS must point to this server). Use "localhost" to try it on your own machine.
DOMAIN=wordrise.example.com
# Where Let's Encrypt sends certificate warnings.
ACME_EMAIL=you@example.com

# A long random password, letters and digits only (it goes inside a connection string).
# The database and the API share it.
POSTGRES_PASSWORD=

# The account that becomes the admin (register it on the site first, then restart the api).
# If left empty, the app uses the list Identity:AdminEmails from appsettings.json instead.
ADMIN_EMAIL=you@example.com

# Lesson writing: key from console.anthropic.com. Leave empty until you have one.
AUTHORING_PROVIDER=Claude
CLAUDE_API_KEY=

# Audio: None keeps the device voice; Azure needs the two values below from an Azure Speech resource.
MEDIA_PROVIDER=None
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Account emails (confirm address, forgot password). Needs a mail server (SMTP) from your provider
# (for example Resend, SendGrid, Brevo, or your own). Until you have one, set REQUIRE_CONFIRMED_EMAIL=false:
# with it on and no working mail, new accounts can never sign in (and admin needs a confirmed address).
REQUIRE_CONFIRMED_EMAIL=false
EMAIL_PROVIDER=Log
EMAIL_FROM=Wordrise <no-reply@wordrise.example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
