<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>wordrise-host</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Generates the mediator for every module's commands and queries; only the host references it. -->
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Wordrise.Shared.Abstractions\Wordrise.Shared.Abstractions.csproj" />
    <ProjectReference Include="..\Modules\Identity\Wordrise.Modules.Identity.Core\Wordrise.Modules.Identity.Core.csproj" />
    <ProjectReference Include="..\Modules\Learning\Wordrise.Modules.Learning.Api\Wordrise.Modules.Learning.Api.csproj" />
    <ProjectReference Include="../Modules/Media/Wordrise.Modules.Media.Core/Wordrise.Modules.Media.Core.csproj" />
    <ProjectReference Include="..\Modules\ContentAuthoring\Wordrise.Modules.ContentAuthoring.Api\Wordrise.Modules.ContentAuthoring.Api.csproj" />
  </ItemGroup>

</Project>
