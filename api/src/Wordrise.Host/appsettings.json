{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "ConnectionString": "",
    "ApplyMigrationsOnStartup": false
  },
  "Identity": {
    "AuthRequestsPerMinute": 10
  },
  "Learning": {
    "TimeZone": "Asia/Riyadh",
    "Reviews": {
      "Enabled": true,
      "MaxPerSession": 20,
      "Backlog": {
        "Enabled": true,
        "Limit": 30
      }
    }
  },
  "Cors": {
    "Origins": []
  }
}
