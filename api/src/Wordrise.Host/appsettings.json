{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Postgres",
    "ConnectionString": "",
    "ApplyMigrationsOnStartup": false
  },
  "Identity": {
    "AuthRequestsPerMinute": 10,
    "AdminEmails": []
  },
  "Learning": {
    "TimeZone": "Asia/Riyadh",
    "Reviews": {
      "Enabled": true,
      "MaxPerSession": 20,
      "Backlog": {
        "Enabled": true,
        "Limit": 30
      }
    }
  },
  "Authoring": {
    "Provider": "Claude",
    "MaxCycles": 3,
    "Worker": {
      "Enabled": true,
      "PollIntervalSeconds": 30,
      "MaxDraftsPerPoll": 3
    },
    "Claude": {
      "ApiKey": "",
      "BaseUrl": "",
      "Writer": { "Model": "claude-opus-5-5", "Effort": "High", "MaxTokens": 16000 },
      "Reviewer": { "Model": "claude-sonnet-5-5", "Effort": "Medium", "MaxTokens": 8000 }
    }
  },
  "Media": {
    "Provider": "None",
    "Azure": {
      "Key": "",
      "Region": "",
      "Voices": {
        "en": { "Locale": "en-US", "Primary": "en-US-JennyNeural", "Secondary": "en-US-GuyNeural" }
      },
      "SlowRate": "-40%"
    },
    "Storage": {
      "Path": "media-data"
    }
  },
  "Cors": {
    "Origins": []
  }
}
